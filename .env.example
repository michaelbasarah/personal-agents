# ---- Discord (your PERSONAL server, not pioNox's) --------------------------------
# Developer Portal → New Application → Bot → Reset Token. Enable the MESSAGE CONTENT
# INTENT on that same page, or the bot reads every message as empty.
DISCORD_TOKEN=

# The channel the bot listens in. Right-click the channel → Copy Channel ID
# (needs Developer Mode on: Settings → Advanced). Falls back to a channel literally
# named "spending" if you leave the ID blank.
SPEND_CHANNEL_ID=
SPEND_CHANNEL_NAME=spending

# Who the bot obeys. Comma-separated Discord user IDs (right-click yourself → Copy User ID).
# EMPTY MEANS NOBODY — this is deliberate; it's your bank statement.
SPEND_USER_IDS=

# ---- Gemini ----------------------------------------------------------------------
GEMINI_API_KEY=
SPEND_MODEL=gemini-2.5-flash

# ---- Google Sheet ----------------------------------------------------------------
# The long ID in the sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
SPEND_SHEET_ID=
SPEND_SHEET_TAB=Spending

# Service-account creds. Either paste the raw JSON on one line, or point at the file.
# Then SHARE THE SHEET with the service account's client_email as an Editor — without
# that, every write is a 403 no matter how right the key is.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---- Locale ----------------------------------------------------------------------
SPEND_TZ=Asia/Jakarta
SPEND_CURRENCY=IDR

# ---- Logging ---------------------------------------------------------------------
# LOG_JSON=1
# LOG_LEVEL=debug
